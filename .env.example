# 复制为 .env 后按需修改（Docker Compose 会自动读取同目录 .env）

# 服务端口
PORT=8080

# 文件根目录：容器内 / 服务器上的实际目录，预设后无需网页首次配置
ROOT_DIR=/files

# 配置与分享记录持久化目录（必须持久化）
DATA_DIR=/app/data

# 反向代理（Nginx / Caddy）后置 1：分享链接自动使用真实域名与 https。
# 默认 0：只有确实架了反代才打开，见下方 TRUSTED_PROXIES
TRUST_PROXY=0

# 打开 TRUST_PROXY 后，采信哪些直连来源送来的 X-Real-IP / X-Forwarded-For。
# 环回（127.0.0.1/::1）恒可信 —— 同机 Nginx/Caddy 不用配；其余代理网段必须在这里
# 显式列出（CIDR，逗号分隔）。注意：容器里直连来源常常是 docker 网桥网关
# （如 172.17.0.1），此时端口是直接暴露给公网的，绝不能把内网地址段整体当可信代理，
# 否则任何人都能用 X-Real-IP 伪造来源、绕开按 IP 记账的登录封禁
# TRUSTED_PROXIES=172.17.0.1/32,192.168.1.10/32

# TLS 由代理终止但未开 TRUST_PROXY 时，会话 Cookie 的 Secure 与 HSTS 无法自动判定，
# 设为 1 强制按 https 处理（HTTPS 部署请用这两者之一）
# COOKIE_SECURE=1

# 管理端 Basic 认证（不设置则任何人可管理；分享下载链接始终免密）
# 用户名与密码必须成对设置，且不要用示例值 —— 公开仓库里写过的默认口令
# 会被直接拿来撞库；只设 AUTH_USER 不设 AUTH_PASS 时服务会拒绝启动
AUTH_USER=admin
AUTH_PASS=

# IP 归属地查询（UAPIs.cn）的 Key，留空 = 访客积分模式
# UAPI_KEY=

# 单个上传文件上限（MB），0 为不限制
MAX_UPLOAD_MB=0

# 访问日志：1 开启 / 0 关闭（只认 1/0/true/false/yes/no/on/off）
LOG=1
