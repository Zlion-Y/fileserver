# 复制为 .env 后按需修改（Docker Compose 会自动读取同目录 .env）

# 服务端口
PORT=8080

# 文件根目录：容器内 / 服务器上的实际目录，预设后无需网页首次配置
ROOT_DIR=/files

# 配置与分享记录持久化目录（必须持久化）
DATA_DIR=/app/data

# 反向代理（Nginx / Caddy）后置为 1：分享链接自动使用真实域名与 https
TRUST_PROXY=1

# 管理端 Basic 认证（不设置则任何人可管理；分享下载链接始终免密）
AUTH_USER=admin
AUTH_PASS=change-me-please

# 单个上传文件上限（MB），0 为不限制
MAX_UPLOAD_MB=0

# 访问日志：1 开启 / 0 关闭
LOG=1
